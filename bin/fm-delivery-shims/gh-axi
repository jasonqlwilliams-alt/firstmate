#!/usr/bin/env bash
# Spawn-only gh-axi shim: fail closed on PR writes outside the configured fork.
set -u

ROOT=${FM_DELIVERY_GUARD_ROOT:-}
REAL=${FM_REAL_GH_AXI:-}
# -ef compares resolved file identity, covering relative paths, symlinks and
# hard links without forking another process before this recursion boundary.
if [ -n "$REAL" ] && [ "$REAL" -ef "${BASH_SOURCE[0]}" ]; then
  printf 'REFUSED: FM_REAL_GH_AXI points to the guarded gh-axi shim itself; a real executable is required.\n' >&2
  exit 1
fi
[ -n "$ROOT" ] && [ -x "$ROOT/bin/fm-delivery-guard.sh" ] || {
  echo "REFUSED: Firstmate gh-axi write guard is unavailable." >&2
  exit 1
}
[ -n "$REAL" ] && [ -x "$REAL" ] || {
  echo "REFUSED: the real gh-axi executable was not recorded before the guarded PATH was installed." >&2
  exit 1
}
FM_GITHUB_GUARD_TOOL=gh-axi
FM_DELIVERY_GUARD_ROOT=$ROOT
export FM_GITHUB_GUARD_TOOL FM_DELIVERY_GUARD_ROOT
# shellcheck source=bin/fm-github-write-guard-lib.sh
. "$ROOT/bin/fm-github-write-guard-lib.sh"
fm_github_guard_check "$@" || exit $?
exec "$REAL" "$@"
