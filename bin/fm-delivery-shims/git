#!/usr/bin/env bash
# Guarded worker entrypoint for Git. The repository pre-push hook owns target
# authorization; this shim prevents Git's explicit hook-bypass path and the
# lower-level send-pack command from stepping around that boundary.
set -u

REAL=${FM_REAL_GIT:-}
# -ef compares resolved file identity, covering relative paths, symlinks and
# hard links without forking another process before this recursion boundary.
if [ -n "$REAL" ] && [ "$REAL" -ef "${BASH_SOURCE[0]}" ]; then
  printf 'REFUSED: FM_REAL_GIT points to the guarded git shim itself; a real executable is required.\n' >&2
  exit 1
fi
[ -n "$REAL" ] && [ -x "$REAL" ] || {
  printf 'REFUSED: guarded git cannot resolve the real Git executable.\n' >&2
  exit 1
}

# Git folds config section and variable names to lowercase, so Core.HooksPath
# and every other spelling name the same key as core.hooksPath. Match those
# keys without regard to case; nocasematch keeps stock macOS Bash 3.2 working.
matches_hooks_path() {  # <text> <glob written in lowercase>
  local matched=1
  shopt -s nocasematch
  # shellcheck disable=SC2053 # the second operand is deliberately a glob
  [[ $1 == $2 ]] && matched=0
  shopt -u nocasematch
  return "$matched"
}

parse_command() {
  local words=("$@") arg i=0
  parsed_command=
  parsed_index=-1
  parsed_hook_override=0
  while [ "$i" -lt "${#words[@]}" ]; do
  arg=${words[$i]}
  case "$arg" in
    -c|--config-env)
      if [ $((i + 1)) -lt "${#words[@]}" ] \
        && matches_hooks_path "${words[$((i + 1))]}" 'core.hookspath=*'; then
        parsed_hook_override=1
      fi
      i=$((i + 2))
      continue
      ;;
    -C|--git-dir|--work-tree|--namespace|--super-prefix)
      i=$((i + 2))
      continue
      ;;
    -ccore.hooksPath=*)
      parsed_hook_override=1
      i=$((i + 1))
      continue
      ;;
    --config-env=*)
      matches_hooks_path "${arg#--config-env=}" 'core.hookspath=*' && parsed_hook_override=1
      i=$((i + 1))
      continue
      ;;
    --git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--exec-path=*|--*)
      i=$((i + 1))
      continue
      ;;
    -*)
      i=$((i + 1))
      continue
      ;;
    *) parsed_command=$arg; parsed_index=$i; break ;;
  esac
  done
}

split_alias_words() {
  local value=$1 token= quote= char i=0
  alias_words=()
  while [ "$i" -lt "${#value}" ]; do
    char=${value:$i:1}
    if [ -z "$quote" ] && [[ $char == [[:space:]] ]]; then
      alias_words+=("$token")
      token=
      while [ $((i + 1)) -lt "${#value}" ] && [[ ${value:$((i + 1)):1} == [[:space:]] ]]; do
        i=$((i + 1))
      done
    elif [ -z "$quote" ] && { [ "$char" = "'" ] || [ "$char" = '"' ]; }; then
      quote=$char
    elif [ -n "$quote" ] && [ "$char" = "$quote" ]; then
      quote=
    else
      if [ "$char" = '\' ] && [ "$quote" != "'" ]; then
        i=$((i + 1))
        [ "$i" -lt "${#value}" ] || return 1
        char=${value:$i:1}
      fi
      token+=$char
    fi
    i=$((i + 1))
  done
  [ -z "$quote" ] || return 1
  alias_words+=("$token")
}

args=("$@")
parse_command "${args[@]}"
command_name=$parsed_command
command_index=$parsed_index
hook_override=$parsed_hook_override
effective_prefix=()
if [ "$command_index" -ge 0 ]; then
  effective_prefix=("${args[@]:0:$command_index}")
fi
alias_options=()
alias_words=()
alias_command_index=-1

# Resolve ordinary Git aliases without evaluating their content. A shell alias
# that can invoke push/send-pack is refused because the nested Git command would
# run outside this wrapper. A non-shell push alias is treated like a direct push,
# including its leading Git options and command-line hook-bypass checks.
resolved_command=$command_name
if [ "$command_index" -ge 0 ] && [ -n "$command_name" ] \
  && [ "$command_name" != push ] && [ "$command_name" != send-pack ]; then
  alias_value=$("$REAL" "${args[@]:0:$command_index}" config --get "alias.$command_name" 2>/dev/null || true)
  case "$alias_value" in
    !*)
      if [[ "$alias_value" =~ (^|[[:space:]/])git[[:space:]]+(push|send-pack)([[:space:]]|$) ]] \
        || [[ "$alias_value" =~ (^|[[:space:]])send-pack([[:space:]]|$) ]]; then
        printf 'REFUSED: a Git shell alias that can push bypasses the Firstmate repository delivery guard.\n' >&2
        exit 1
      fi
      ;;
    *)
      if ! split_alias_words "$alias_value"; then
        push_token_regex="(^|[[:space:]\"'\\\\])push($|[[:space:]\"'\\\\])"
        if [[ $alias_value =~ $push_token_regex ]]; then
          printf 'REFUSED: a Git push alias cannot be parsed by the Firstmate repository delivery guard.\n' >&2
          exit 1
        fi
        exec "$REAL" "$@"
      fi
      parse_command "${alias_words[@]}"
      case "$parsed_command" in
        push|send-pack)
          resolved_command=$parsed_command
          alias_command_index=$parsed_index
          if [ "$parsed_index" -gt 0 ]; then
            alias_options=("${alias_words[@]:0:$parsed_index}")
            effective_prefix+=("${alias_options[@]}")
          fi
          [ "$parsed_hook_override" -eq 0 ] || hook_override=1
          ;;
      esac
      ;;
  esac
fi

if [ "$resolved_command" = push ]; then
  matches_hooks_path "${GIT_CONFIG_PARAMETERS:-}" '*core.hookspath*' && hook_override=1
  config_count=${GIT_CONFIG_COUNT:-0}
  case "$config_count" in ''|*[!0-9]*) config_count=0 ;; esac
  i=0
  while [ "$i" -lt "$config_count" ]; do
    config_key_name="GIT_CONFIG_KEY_$i"
    matches_hooks_path "${!config_key_name:-}" core.hookspath && hook_override=1
    i=$((i + 1))
  done
  if [ "$hook_override" -eq 1 ]; then
    printf 'REFUSED: git push cannot override the Firstmate pre-push hook configuration.\n' >&2
    exit 1
  fi
fi

case "$resolved_command" in
  push)
    for arg in "${args[@]}"; do
      if [ "$arg" = --no-verify ]; then
        printf 'REFUSED: git push --no-verify cannot bypass the Firstmate repository delivery guard.\n' >&2
        exit 1
      fi
    done
    case " ${alias_value:-} " in
      *' --no-verify '*)
        printf 'REFUSED: a Git push alias cannot disable the Firstmate repository delivery guard.\n' >&2
        exit 1
        ;;
    esac
    ;;
  send-pack)
    printf 'REFUSED: git send-pack bypasses the Firstmate repository delivery guard; use guarded git push.\n' >&2
    exit 1
    ;;
esac

# The checks above name explicit override spellings, but Git resolves
# core.hooksPath from every config source, including included files (from the
# command line, the environment, or a repository file) and a rewritten or
# removed repository value. So for a push from a repository that delivery arming
# has armed, ask the real Git which hooks directory this exact invocation
# resolves (same global options, environment, and working directory) and refuse
# unless it is the managed directory install_guard in bin/fm-delivery-guard.sh
# installs at <git-common-dir>/firstmate-hooks. Comparing file identity accepts
# any equivalent spelling of that directory.
#
# The push itself then runs with that directory pinned as the last command-line
# config, which outranks every config file, include, and earlier override, so a
# config edit between this check and Git's own read cannot redirect the hook.
# Git keeps the pin out of a local-path remote's receive-pack, but hook children
# and submodule pushes inherit it through GIT_CONFIG_PARAMETERS, so a guarded
# push nested inside a hook is refused by the environment check above.
#
# A repository counts as armed while any firstmate.* key arming writes is
# present. A worker that deletes all of them, or
# rewrites the managed hook itself, steps outside what a PATH shim can enforce.
pinned_hooks=
if [ "$resolved_command" = push ]; then
  common=$("$REAL" "${effective_prefix[@]}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
  if [ -z "$common" ]; then
    exec "$REAL" "$@"
  fi
  managed="$common/firstmate-hooks"
  armed=0
  marker_rc=0
  "$REAL" "${effective_prefix[@]}" config --local --get-regexp \
    '^firstmate\.(projectname|guardroot|guardhome|previoushookspath)$' >/dev/null 2>&1 || marker_rc=$?
  case "$marker_rc" in
    0) armed=1 ;;
    1) ;;
    *)
      printf 'REFUSED: git push cannot read this repository'"'"'s Firstmate guard configuration.\n' >&2
      exit 1
      ;;
  esac
  if [ "$armed" -eq 1 ]; then
    effective=$("$REAL" "${effective_prefix[@]}" rev-parse --path-format=absolute --git-path hooks 2>/dev/null) || effective=
    if [ -z "$effective" ] || [ ! -d "$managed" ] || [ ! "$effective" -ef "$managed" ]; then
      printf 'REFUSED: git push would run hooks from %s instead of the Firstmate managed hooks at %s; restore core.hooksPath to the managed directory.\n' \
        "${effective:-<unresolved>}" "$managed" >&2
      exit 1
    fi
    pinned_hooks=$managed
  fi
fi

if [ -n "$pinned_hooks" ]; then
  if [ "${#alias_options[@]}" -gt 0 ]; then
    exec "$REAL" "${effective_prefix[@]}" -c "core.hooksPath=$pinned_hooks" \
      "${alias_words[@]:$alias_command_index}" "${args[@]:$((command_index + 1))}"
  fi
  exec "$REAL" "${args[@]:0:$command_index}" -c "core.hooksPath=$pinned_hooks" "${args[@]:$command_index}"
fi
exec "$REAL" "$@"
